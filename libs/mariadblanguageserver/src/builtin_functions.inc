FN("STD", "STD(expr)", "Returns the population standard deviation of expr. This is an extension to standard SQL. The standard SQL function STDDEV_POP() can be used instead.", "https://mariadb.com/kb/en/std/")
FN("STDDEV", "STDDEV(expr)", "Returns the population standard deviation of expr. This function is provided for compatibility with Oracle. The standard SQL function STDDEV_POP() can be used instead.", "https://mariadb.com/kb/en/stddev/")
FN("STDDEV_POP", "STDDEV_POP(expr)", "Returns the population standard deviation of expr (the square root of VAR_POP()). You can also use STD() or STDDEV(), which are equivalent but not standard SQL.", "https://mariadb.com/kb/en/stddev_pop/")
FN("STDDEV_SAMP", "STDDEV_SAMP(expr)", "Returns the sample standard deviation of expr (the square root of VAR_SAMP()).", "https://mariadb.com/kb/en/stddev_samp/")
FN("STRCMP", "STRCMP(expr1,expr2)", "STRCMP() returns 0 if the strings are the same, -1 if the first argument is smaller than the second according to the current sort order, and 1 if the strings are otherwise not the same. Returns NULL is either argument is NULL.", "https://mariadb.com/kb/en/strcmp/")
FN("STR_TO_DATE", "STR_TO_DATE(str,format)", "This is the inverse of the DATE_FORMAT() function. It takes a string str and a format string format. STR_TO_DATE() returns a DATETIME value if the format string contains both date and time parts, or a DATE or TIME value if the string contains only date or time parts.", "https://mariadb.com/kb/en/str_to_date/")
FN("ST_AREA", "ST_Area(poly)", "Returns as a double-precision number the area of the Polygon value poly, as measured in its spatial reference system.", "https://mariadb.com/kb/en/st_area/")
FN("ST_ASBINARY", "ST_AsBinary(g)", "Converts a value in internal geometry format to its WKB representation and returns the binary result.", "https://mariadb.com/kb/en/st_asbinary/")
FN("ST_ASGEOJSON", "ST_AsGeoJSON(g[, max_decimals[, options]])", "Returns the given geometry g as a GeoJSON element. The optional max_decimals limits the maximum number of decimals displayed.", "https://mariadb.com/kb/en/geojson-st_asgeojson/")
