FN("LN", "LN(X)", "Returns the natural logarithm of X; that is, the base-e logarithm of X. If X is less than or equal to 0, or NULL, then NULL is returned.", "https://mariadb.com/kb/en/ln/")
FN("LOAD_FILE", "LOAD_FILE(file_name)", "Reads the file and returns the file contents as a string. To use this function, the file must be located on the server host, you must specify the full path name to the file, and you must have the FILE privilege. The file must be readable by all and it must be less than the size, in bytes, of the max_allowed_packet system variable.", "https://mariadb.com/kb/en/load_file/")
FN("LOCATE", "LOCATE(substr,str), LOCATE(substr,str,pos)", "The first syntax returns the position of the first occurrence of substring substr in string str. The second syntax returns the position of the first occurrence of substring substr in string str, starting at position pos. Returns 0 if substr is not in str.", "https://mariadb.com/kb/en/locate/")
FN("LOG", "LOG(X), LOG(B,X)", "If called with one parameter, this function returns the natural logarithm of X. If X is less than or equal to 0, then NULL is returned.", "https://mariadb.com/kb/en/log/")
FN("LOG10", "LOG10(X)", "Returns the base-10 logarithm of X.", "https://mariadb.com/kb/en/log10/")
FN("LOG2", "LOG2(X)", "Returns the base-2 logarithm of X.", "https://mariadb.com/kb/en/log2/")
FN("LONGFROMGEOHASH", "", "", "")
FN("LOWER", "LOWER(str)", "Returns the string str with all characters changed to lowercase according to the current character set mapping. The default is latin1 (cp1252 West European).", "https://mariadb.com/kb/en/lower/")
FN("LPAD", "LPAD(str, len [,padstr])", "Returns the string str, left-padded with the string padstr to a length of len characters. If str is longer than len, the return value is shortened to len characters. If padstr is omitted, the LPAD function pads spaces.", "https://mariadb.com/kb/en/lpad/")
FN("LTRIM", "LTRIM(str)", "Returns the string str with leading space characters removed.", "https://mariadb.com/kb/en/ltrim/")
FN("MAKEDATE", "MAKEDATE(year,dayofyear)", "Returns a date, given year and day-of-year values. dayofyear must be greater than 0 or the result is NULL.", "https://mariadb.com/kb/en/makedate/")
FN("MAKETIME", "MAKETIME(hour,minute,second)", "Returns a time value calculated from the hour, minute, and second arguments.", "https://mariadb.com/kb/en/maketime/")
FN("MAKE_SET", "MAKE_SET(bits,str1,str2,...)", "Returns a set value (a string containing substrings separated by \",\" characters) consisting of the strings that have the corresponding bit in bits set. str1 corresponds to bit 0, str2 to bit 1, and so on. NULL values in str1, str2, ... are not appended to the result.", "https://mariadb.com/kb/en/make_set/")
FN("MASTER_GTID_WAIT", "MASTER_GTID_WAIT(gtid-list[, timeout)", "This function takes a string containing a comma-separated list of global transaction id's (similar to the value of, for example, gtid_binlog_pos). It waits until the value of gtid_slave_pos has the same or higher seq_no within all replication domains specified in the gtid-list; in other words, it waits until the slave has reached the specified GTID position.", "https://mariadb.com/kb/en/master_gtid_wait/")
FN("MASTER_POS_WAIT", "MASTER_POS_WAIT(log_name,log_pos[,timeout,[\"connection_name\"]])", "This function is useful in replication for controlling master/slave synchronization. It blocks until the slave has read and applied all updates up to the specified position (log_name,log_pos) in the binary log. The return value is the number of log events the slave had to wait for to advance to the specified position.", "https://mariadb.com/kb/en/master_pos_wait/")
FN("MAX", "MAX([DISTINCT] expr)", "Returns the largest, or maximum, value of expr. MAX() can also take a string argument in which case it returns the maximum string value. The DISTINCT keyword can be used to find the maximum of the distinct values of expr, however, this produces the same result as omitting DISTINCT.", "https://mariadb.com/kb/en/max/")
FN("MBRCONTAINS", "MBRContains(g1,g2)", "Returns 1 or 0 to indicate whether the Minimum Bounding Rectangle of g1 contains the Minimum Bounding Rectangle of g2. This tests the opposite relationship as MBRWithin().", "https://mariadb.com/kb/en/mbrcontains/")
FN("MBRCOVEREDBY", "", "", "")
FN("MBRDISJOINT", "MBRDisjoint(g1,g2)", "Returns 1 or 0 to indicate whether the Minimum Bounding Rectangles of the two geometries g1 and g2 are disjoint. Two geometries are disjoint if they do not intersect, that is touch or overlap.", "https://mariadb.com/kb/en/mbrdisjoint/")
FN("MBREQUAL", "MBREqual(g1,g2)", "Returns 1 or 0 to indicate whether the Minimum Bounding Rectangles of the two geometries g1 and g2 are the same.", "https://mariadb.com/kb/en/mbrequal/")
FN("MBREQUALS", "", "", "")
FN("MBRINTERSECTS", "MBRIntersects(g1,g2)", "Returns 1 or 0 to indicate whether the Minimum Bounding Rectangles of the two geometries g1 and g2 intersect.", "https://mariadb.com/kb/en/mbrintersects/")
FN("MBROVERLAPS", "MBROverlaps(g1,g2)", "Returns 1 or 0 to indicate whether the Minimum Bounding Rectangles of the two geometries g1 and g2 overlap. The term spatially overlaps is used if two geometries intersect and their intersection results in a geometry of the same dimension but not equal to either of the given geometries.", "https://mariadb.com/kb/en/mbroverlaps/")
FN("MBRTOUCHES", "MBRTouches(g1,g2)", "Returns 1 or 0 to indicate whether the Minimum Bounding Rectangles of the two geometries g1 and g2 touch. Two geometries spatially touch if the interiors of the geometries do not intersect, but the boundary of one of the geometries intersects either the boundary or the interior of the other.", "https://mariadb.com/kb/en/mbrtouches/")
FN("MBRWITHIN", "MBRWithin(g1,g2)", "Returns 1 or 0 to indicate whether the Minimum Bounding Rectangle of g1 is within the Minimum Bounding Rectangle of g2. This tests the opposite relationship as MBRContains().", "https://mariadb.com/kb/en/mbrwithin/")
FN("MD5", "MD5(str)", "Calculates an MD5 128-bit checksum for the string.", "https://mariadb.com/kb/en/md5/")
FN("MEDIAN", "", "", "")
FN("MICROSECOND", "MICROSECOND(expr)", "Returns the microseconds from the time or datetime expression expr as a number in the range from 0 to 999999.", "https://mariadb.com/kb/en/microsecond/")
FN("MID", "MID(str,pos,len)", "MID(str,pos,len) is a synonym for SUBSTRING(str,pos,len).", "https://mariadb.com/kb/en/mid/")
FN("MIN", "MIN([DISTINCT] expr)", "Returns the minimum value of expr. MIN() may take a string argument, in which case it returns the minimum string value. The DISTINCT keyword can be used to find the minimum of the distinct values of expr, however, this produces the same result as omitting DISTINCT.", "https://mariadb.com/kb/en/min/")
FN("MINUTE", "MINUTE(time)", "Returns the minute for time, in the range 0 to 59.", "https://mariadb.com/kb/en/minute/")
FN("MLINEFROMTEXT", "MLineFromText(wkt[,srid])", "Constructs a MULTILINESTRING value using its WKT representation and SRID.", "https://mariadb.com/kb/en/mlinefromtext/")
FN("MLINEFROMWKB", "MLineFromWKB(wkb[,srid])", "Constructs a MULTILINESTRING value using its WKB representation and SRID.", "https://mariadb.com/kb/en/mlinefromwkb/")
FN("MOD", "MOD(N,M), N % M, N MOD M", "Modulo operation. Returns the remainder of N divided by M. See also Modulo Operator.", "https://mariadb.com/kb/en/mod/")
FN("MONTH", "MONTH(date)", "Returns the month for date in the range 1 to 12 for January to December, or 0 for dates such as '0000-00-00' or '2008-00-00' that have a zero month part.", "https://mariadb.com/kb/en/month/")
FN("MONTHNAME", "MONTHNAME(date)", "Returns the full name of the month for date. The language used for the name is controlled by the value of the lc_time_names system variable. See server locale for more on the supported locales.", "https://mariadb.com/kb/en/monthname/")
FN("MONTHS_BETWEEN", "", "", "")
FN("MPOINTFROMTEXT", "MPointFromText(wkt[,srid])", "Constructs a MULTIPOINT value using its WKT representation and SRID.", "https://mariadb.com/kb/en/mpointfromtext/")
FN("MPOINTFROMWKB", "MPointFromWKB(wkb[,srid])", "Constructs a MULTIPOINT value using its WKB representation and SRID.", "https://mariadb.com/kb/en/mpointfromwkb/")
FN("MPOLYFROMTEXT", "MPolyFromText(wkt[,srid])", "Constructs a MULTIPOLYGON value using its WKT representation and SRID.", "https://mariadb.com/kb/en/mpolyfromtext/")
FN("MPOLYFROMWKB", "MPolyFromWKB(wkb[,srid])", "Constructs a MULTIPOLYGON value using its WKB representation and SRID.", "https://mariadb.com/kb/en/mpolyfromwkb/")
