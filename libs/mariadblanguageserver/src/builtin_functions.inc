FN("POSITION", "POSITION(substr IN str)", "POSITION(substr IN str) is a synonym for LOCATE(substr,str).", "https://mariadb.com/kb/en/position/")
FN("POW", "POW(X,Y)", "Returns the value of X raised to the power of Y.", "https://mariadb.com/kb/en/pow/")
FN("POWER", "POWER(X,Y)", "This is a synonym for POW(), which returns the value of X raised to the power of Y.", "https://mariadb.com/kb/en/power/")
FN("QUARTER", "QUARTER(date)", "Returns the quarter of the year for date, in the range 1 to 4. Returns 0 if month contains a zero value, or NULL if the given value is not otherwise a valid date (zero values are accepted).", "https://mariadb.com/kb/en/quarter/")
FN("QUOTE", "QUOTE(str)", "Quotes a string to produce a result that can be used as a properly escaped data value in an SQL statement. The string is returned enclosed by single quotes and with each instance of single quote (\"'\"), backslash (\"\\\"), ASCII NUL, and Control-Z preceded by a backslash. If the argument is NULL, the return value is the word \"NULL\" without enclosing single quotes.", "https://mariadb.com/kb/en/quote/")
FN("RADIANS", "RADIANS(X)", "Returns the argument X, converted from degrees to radians. Note that π radians equals 180 degrees.", "https://mariadb.com/kb/en/radians/")
FN("RAND", "RAND(), RAND(N)", "Returns a random DOUBLE precision floating point value v in the range 0 <= v < 1.0. If a constant integer argument N is specified, it is used as the seed value, which produces a repeatable sequence of column values. In the example below, note that the sequences of values produced by RAND(3) is the same both places where it occurs.", "https://mariadb.com/kb/en/rand/")
FN("RANDOM_BYTES", "RANDOM_BYTES(length)", "Given a length from 1 to 1024, generates a binary string of length consisting of random bytes generated by the SSL library's random number generator.", "https://mariadb.com/kb/en/random_bytes/")
FN("RANK", "RANK() OVER (", "RANK() is a window function that displays the number of a given row, starting at one and following the ORDER BY sequence of the window function, with identical values receiving the same result. It is similar to the ROW_NUMBER() function except that in that function, identical values will receive a different row number for each result.", "https://mariadb.com/kb/en/rank/")
FN("REGEXP_INSTR", "REGEXP_INSTR(subject, pattern)", "", "https://mariadb.com/kb/en/regexp_instr/")
FN("REGEXP_REPLACE", "REGEXP_REPLACE(subject, pattern, replace)", "REGEXP_REPLACE returns the string subject with all occurrences of the regular expression pattern replaced by the string replace. If no occurrences are found, then subject is returned as is.", "https://mariadb.com/kb/en/regexp_replace/")
FN("REGEXP_SUBSTR", "REGEXP_SUBSTR(subject,pattern)", "Returns the part of the string subject that matches the regular expression pattern, or an empty string if pattern was not found.", "https://mariadb.com/kb/en/regexp_substr/")
FN("RELEASE_ALL_LOCKS", "RELEASE_ALL_LOCKS()", "Releases all named locks held by the current session. Returns the number of locks released, or 0 if none were held.", "https://mariadb.com/kb/en/release_all_locks/")
FN("RELEASE_LOCK", "RELEASE_LOCK(str)", "Releases the lock named by the string str that was obtained with GET_LOCK(). Returns 1 if the lock was released, 0 if the lock was not established by this thread (in which case the lock is not released), and NULL if the named lock did not exist. The lock does not exist if it was never obtained by a call to GET_LOCK() or if it has previously been released.", "https://mariadb.com/kb/en/release_lock/")
FN("REPEAT", "REPEAT(str,count)", "Returns a string consisting of the string str repeated count times. If count is less than 1, returns an empty string. Returns NULL if str or count are NULL.", "https://mariadb.com/kb/en/repeat-function/")
FN("REPLACE", "REPLACE(str,from_str,to_str)", "Returns the string str with all occurrences of the string from_str replaced by the string to_str. REPLACE() performs a case-sensitive match when searching for from_str.", "https://mariadb.com/kb/en/replace-function/")
FN("REVERSE", "REVERSE(str)", "Returns the string str with the order of the characters reversed.", "https://mariadb.com/kb/en/reverse/")
FN("RIGHT", "RIGHT(str,len)", "Returns the rightmost len characters from the string str, or NULL if any argument is NULL.", "https://mariadb.com/kb/en/right/")
FN("ROUND", "ROUND(X), ROUND(X,D)", "Rounds the argument X to D decimal places. D defaults to 0 if not specified. D can be negative to cause D digits left of the decimal point of the value X to become zero.", "https://mariadb.com/kb/en/round/")
FN("ROW_COUNT", "ROW_COUNT()", "ROW_COUNT() returns the number of rows updated, inserted or deleted by the preceding statement. This is the same as the row count that the mariadb client displays and the value from the mysql_affected_rows() C API function.", "https://mariadb.com/kb/en/row_count/")
FN("RPAD", "RPAD(str, len [, padstr])", "Returns the string str, right-padded with the string padstr to a length of len characters. If str is longer than len, the return value is shortened to len characters. If padstr is omitted, the RPAD function pads spaces.", "https://mariadb.com/kb/en/rpad/")
FN("RTRIM", "RTRIM(str)", "Returns the string str with trailing space characters removed.", "https://mariadb.com/kb/en/rtrim/")
FN("SCHEMA", "SCHEMA()", "This function is a synonym for DATABASE().", "https://mariadb.com/kb/en/schema/")
FN("SECOND", "SECOND(time)", "Returns the second for a given time (which can include microseconds), in the range 0 to 59, or NULL if not given a valid time value.", "https://mariadb.com/kb/en/second/")
FN("SEC_TO_TIME", "SEC_TO_TIME(seconds)", "Returns the seconds argument, converted to hours, minutes, and seconds, as a TIME value. The range of the result is constrained to that of the TIME data type. A warning occurs if the argument corresponds to a value outside that range.", "https://mariadb.com/kb/en/sec_to_time/")
FN("SESSION_USER", "SESSION_USER()", "SESSION_USER() is a synonym for USER().", "https://mariadb.com/kb/en/session_user/")
