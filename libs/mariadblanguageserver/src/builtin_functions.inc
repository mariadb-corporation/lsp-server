FN("YEAR", "YEAR(date)", "Returns the year for the given date, in the range 1000 to 9999, or 0 for the \"zero\" date.", "https://mariadb.com/kb/en/year/")
FN("YEARWEEK", "YEARWEEK(date), YEARWEEK(date,mode)", "Returns year and week for a date. The mode argument works exactly like the mode argument to WEEK(). The year in the result may be different from the year in the date argument for the first and the last week of the year.", "https://mariadb.com/kb/en/yearweek/")
