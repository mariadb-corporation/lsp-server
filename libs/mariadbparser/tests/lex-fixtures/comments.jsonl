{"cc": "sql_lex.cc:2556", "comment": "'/*!' with no version digits: 'Not a version comment' - the body is lexed as SQL and in_comment stays DISCARD_COMMENT, so the '*/' is eaten by MY_LEX_END_LONG_COMMENT", "id": "ver-no-digits", "mode": "", "sql": "/*! SELECT */ 1", "tokens": [["SELECT_SYM", "SELECT"], ["NUM", "1"], ["END_OF_INPUT", ""]], "valid": "none"}
{"cc": "sql_lex.cc:2488", "comment": "version <= MYSQL_VERSION_ID (130100 == 130100) -> executed", "id": "ver-equal", "mode": "", "sql": "/*!130100 SELECT */ 1", "tokens": [["SELECT_SYM", "SELECT"], ["NUM", "1"], ["END_OF_INPUT", ""]], "valid": "none"}
{"cc": "sql_lex.cc:2488", "comment": "130099 < 130100 -> executed (the boundary below)", "id": "ver-below", "mode": "", "sql": "/*!130099 SELECT */ 1", "tokens": [["SELECT_SYM", "SELECT"], ["NUM", "1"], ["END_OF_INPUT", ""]], "valid": "none"}
{"cc": "sql_lex.cc:2488", "comment": "130101 > 130100 -> the comment is skipped (the boundary above)", "id": "ver-above", "mode": "", "sql": "/*!130101 SELECT */ 1", "tokens": [["NUM", "1"], ["END_OF_INPUT", ""]], "valid": "none"}
{"cc": "sql_lex.cc:2490", "comment": "50700..99999 is the MySQL 5.7 exclusion range: skipped although 50700 <= 130100", "id": "ver-5digit-mysql-range", "mode": "", "sql": "/*!50700 SELECT */ 1", "tokens": [["NUM", "1"], ["END_OF_INPUT", ""]], "valid": "none"}
{"cc": "sql_lex.cc:2490", "comment": "version < 50700 -> executed", "id": "ver-5digit-below-range", "mode": "", "sql": "/*!50699 SELECT */ 1", "tokens": [["SELECT_SYM", "SELECT"], ["NUM", "1"], ["END_OF_INPUT", ""]], "valid": "none"}
{"cc": "sql_lex.cc:2490", "comment": "99999 is the top of the excluded range -> skipped", "id": "ver-99999", "mode": "", "sql": "/*!99999 SELECT */ 1", "tokens": [["NUM", "1"], ["END_OF_INPUT", ""]], "valid": "none"}
{"cc": "sql_lex.cc:2490", "comment": "version > 99999 -> executed", "id": "ver-100000", "mode": "", "sql": "/*!100000 SELECT */ 1", "tokens": [["SELECT_SYM", "SELECT"], ["NUM", "1"], ["END_OF_INPUT", ""]], "valid": "none"}
