{"cc": "sql_lex.cc:2493", "comment": "reversed comment: executed when MYSQL_VERSION_ID < version", "id": "ver-reversed-above", "mode": "", "sql": "/*!!130101 SELECT */ 1", "tokens": [["SELECT_SYM", "SELECT"], ["NUM", "1"], ["END_OF_INPUT", ""]], "valid": "none"}
